    { "id": "nfc-hangul-composed", "note": "NFC Hangul 算术组合：L(U+1100)+V(U+1161)+T(U+11A8) ⇒ U+AC01", "input": "\u1100\u1161\u11A8", "expected": "s:%EA%B0%81" }
