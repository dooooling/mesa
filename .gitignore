# Rust 构建产物
/target

# 本地运行日志
*.log

# IDE
.idea/
.vscode/

# 本地运行时数据库（ConfigStore/SQLite/EventStore，未跟踪的运行库一律忽略）
*.db
mesa*.db
mesa*.db-wal
mesa*.db-shm
mesa.db.bak.*
*.db-wal
*.db-shm
*.bak.*

# OPC UA 证书（本地生成）
/data/
/certificates/

# Secret master key（P0-1：真 key 永不入仓；测试只用内存固定 key 或 DB 同目录文件）
**/master.key
**/master.tmp

# Driver 构建产物（cargo build 产于 target，drivers/ 下为 QEMU/本地调试拷贝，勿入仓）
# 注：driver.toml 中 executable 为 "Mesa-driver-*"（大写 M），而 cargo bin 为 "mesa-driver-*"（小写），
# Windows 不区分大小写但 Linux 区分，故同时忽略两种大小写；forgelink 为历史命名遗留
drivers/*/mesa-driver-*
drivers/*/Mesa-driver-*
drivers/*/forgelink-driver-*
drivers/simulator/*.d
drivers/s7/*.d
drivers/focas2/*.d
drivers/opcua/*.d
forgelink*.db

# 前端产物
apps/mesa-web/node_modules/
apps/mesa-web/dist/
apps/mesa-web/*.tsbuildinfo
tests/driver-contract/data/

# 临时 ARM/性能产物
/target
/aarch64-mesad
/arm_test.sh
/arm_s7*.sh

# Release 产物（每次生成，非长期提交）
/release-validation.json
/target/validation/

# Python 解释器缓存（证据脚本 `scripts/write-contract-evidence.py` 会 import
# `contract_suites.py` 并生成 scripts/__pycache__/；不忽略会让 `git status`
# 变脏、使官方证据恒为 dirty=true，从而无法产出干净工作树的证据）
__pycache__/
*.pyc

# 本地取证包（pktmon ETL/pcapng：provenance 源，存 evidence/ 本地备查，不进仓；
# 权威证据为 tests/fixtures/** 的 req/res bin + EVIDENCE/SHA256SUMS）
*.etl
*.pcapng
/evidence/
/*_flows/

# 本地「保存意图证明」文件（评审/父代理现场生成的临时证据，不进仓）
# 只精确忽略这一个路径：不要写成 *.json，避免误伤仓库内其它证据文件。
# mesad 生成的运行时意图凭证（G7 停止意图围栏）。文件本身保留在工作区，不删除。
/mesa.db.intent-proof.json
