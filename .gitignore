# Rust 构建产物
/target

# 本地运行日志
*.log

# IDE
.idea/
.vscode/

# 本地运行时数据库（ConfigStore/SQLite）
mesa*.db
mesa*.db-wal
mesa*.db-shm
mesa.db.bak.*
*.db-wal
*.db-shm
*.bak.*

# OPC UA 证书（本地生成）
/data/
/certificates/

# Driver 构建产物（cargo build 产于 target，drivers/ 下为 QEMU/本地调试拷贝，勿入仓）
# 注：driver.toml 中 executable 为 "Mesa-driver-*"（大写 M），而 cargo bin 为 "mesa-driver-*"（小写），
# Windows 不区分大小写但 Linux 区分，故同时忽略两种大小写；forgelink 为历史命名遗留
drivers/*/mesa-driver-*
drivers/*/Mesa-driver-*
drivers/*/forgelink-driver-*
drivers/simulator/*.d
drivers/s7/*.d
drivers/focas2/*.d
drivers/opcua/*.d
forgelink*.db

# 前端产物
apps/mesa-web/node_modules/
apps/mesa-web/dist/
apps/mesa-web/*.tsbuildinfo
tests/driver-contract/data/

# 临时 ARM/性能产物
/target
/aarch64-mesad
/arm_test.sh
/arm_s7*.sh

# Release 产物（每次生成，非长期提交）
/release-validation.json
/target/validation/
